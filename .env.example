# Copia a .env.local. Estas variables quedan en el navegador: solo valores públicos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Número con indicativo y sin signos. No hay valor por defecto.
VITE_WHATSAPP_NUMBER=

# Copia lo siguiente a .env.test.local (solo para pruebas e2e y creación de usuarios).
# Nunca uses el prefijo VITE_ en estas variables.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Secretos de Edge Functions, con: npx supabase secrets set NOMBRE=valor
# IP_HASH_SALT=
# ALLOWED_ORIGINS=http://localhost:5173,https://tu-app.vercel.app
